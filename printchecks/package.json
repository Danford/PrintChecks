{
  "name": "@printchecks/app",
  "version": "1.0.0",
  "description": "Professional check printing and payment documentation system that runs locally in your browser",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:clear": "node scripts/clear-history.js",
    "cleanup": "node scripts/cleanup-debug.js",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^2.1.3",
    "print-js": "^1.6.0",
    "printjs": "^1.1.0",
    "to-words": "^4.1.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@tsconfig/node18": "^2.0.1",
    "@types/node": "^18.16.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "typescript": "~5.4.5",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
